
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out registration page...'
                // Use this if your project is in Git:
                // git branch: 'main',
                //     url: 'https://github.com/USERNAME/REPOSITORY.git'
            }
        }

        stage('Check HTML Files') {
            steps {
                script {
                    if (!fileExists('index.html')) {
                        error('index.html not found in workspace!')
                    }
                }
                echo 'HTML file found successfully.'
            }
        }

        stage('Deploy Locally') {
            steps {
                echo 'Starting local web server...'

                bat '''
                    @echo off
                    start "Registration Web Server" /B python -m http.server 8080
                '''
            }
        }
    }

    post {
        success {
            echo 'Registration page deployment completed.'
            echo 'Open http://localhost:8080 in your browser.'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
